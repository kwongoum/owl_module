<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="owl_module.Main">

        <div class="card p-3 mt-3">

            <h3>Mon premier composant OWL avec Odoo 17</h3>

            <p>Bienvenue dans mon composant OWL !</p>

            <button
                type="button"
                class="btn btn-primary"
                t-on-click="increment">

                Increment : <t t-esc="state.value"/>

            </button>
            <input
                type="text"
                t-ref="myInput"
                class="form-control mt-2"
                placeholder="Entrez quelque chose..." />
                <button t-on-click="onButtonClick">click</button>

        </div>
        <Sub  name="'in sub tag'" />

    </t>

</templates>